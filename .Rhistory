# ------------------------------------------------------------
# Starting up
# ------------------------------------------------------------
setwd("C:/Dick/Post-doc/Experiments/DZ118 - Evaluating mixed imputation compared to other methods/Data analysis complete")
library(tidyverse)
library(DEP)
library(SummarizedExperiment)
library(mice)
library(PTXQC)
# Overview datasets
datasets <- data.frame(dataset = c("Guo2026", "Weijers2025", "Zijlmans2022", "Zijlmans2025"),
mode = c("DIA", "DIA", "DDA", "DDA"),
FC = c(1.5, 2, 2, 4))
# ------------------------------------------------------------
#  Import and clean data
# ------------------------------------------------------------
Cleaned_datasets <- list()
for (i in 1:nrow(datasets)) {
print(i)
data_info <- datasets[i ,]
if (data_info$mode == "DIA") {
# Import files
proteinGroups <- read.delim(paste0(getwd(), "/Datasets/", data_info$dataset, ".pg_matrix.tsv"))
peptides <- read.delim(paste0(getwd(), "/Datasets/", data_info$dataset, ".pr_matrix.tsv"))
# Filter on number of unique peptides
filtered_proteinGroups <- data.frame(
Protein.Group = names(table(unique(peptides[, c('Protein.Group', 'Stripped.Sequence')])$Protein.Group)),
Peptide.Count = as.integer(table(unique(peptides[, c('Protein.Group', 'Stripped.Sequence')])$Protein.Group))
) %>%
filter(Peptide.Count > 2)
proteinGroups <- proteinGroups[proteinGroups$Protein.Group %in% filtered_proteinGroups$Protein.Group, ]
# Remove contaminants and keratins
proteinGroups <-
make_unique(proteinGroups, "Genes", "Protein.Group", delim = ";")
proteinGroups <- proteinGroups %>% filter(!grepl("Cont_", ID) &
!grepl("KRT", name) &
!grepl("cRAP", name) &
!grepl("cRAP", Protein.Group))
# Tidy column names
proteinGroups <- proteinGroups %>% dplyr::rename(Protein.IDs = "Protein.Group")
value_columns <- which(sapply(proteinGroups, is.numeric))
prefix <- LCSn(colnames(proteinGroups[, value_columns]))
colnames(proteinGroups) <- gsub(".raw", "", gsub(".*" %>% paste0(prefix), "", colnames(proteinGroups)))
Cleaned_datasets[[data_info$dataset]] <- proteinGroups
} else {
# Import files
proteinGroups <- read.delim(paste0(getwd(), "/Datasets/", data_info$dataset, "proteinGroups.txt"))
# Filter on number of unique peptides and remove contaminants
proteinGroups$Only.identified.by.site[is.na(proteinGroups$Only.identified.by.site)] <- ""
proteinGroups$Reverse[is.na(proteinGroups$Reverse)] <- ""
proteinGroups$Potential.contaminant[is.na(proteinGroups$Potential.contaminant)] <- ""
proteinGroups <-
filter(
proteinGroups,
Reverse != "+",
Potential.contaminant != "+",
Only.identified.by.site != "+",
Unique.peptides > 2
)
# Tidy column names
proteinGroups <- proteinGroups %>% dplyr::select(
Protein.IDs = "Protein.IDs",
"Gene.names",
contains("LFQ.intensity."),
)
proteinGroups <-
make_unique(proteinGroups, "Gene.names", "Protein.IDs", delim = ";")
value_columns <- which(str_detect(names(proteinGroups), "LFQ.intensity"))
prefix <- LCSn(colnames(proteinGroups[, value_columns]))
colnames(proteinGroups) <- gsub(".raw", "", gsub(".*" %>% paste0(prefix), "", colnames(proteinGroups)))
Cleaned_datasets[[data_info$dataset]] <- proteinGroups
}
}
rm(i, data_info, filtered_proteinGroups, peptides, proteinGroups, prefix, value_columns)
# ------------------------------------------------------------
# Done
# ------------------------------------------------------------
View(Cleaned_datasets)
Cleaned_datasets[3]
a <- log2(Cleaned_datasets[3])
a <- log2(Cleaned_datasets[3][which(sapply(Cleaned_datasets[[3]], is.numeric))])
library(tidyverse)
data <- mutate_if(Cleaned_datasets[3], is.numeric, log2)
data <- mutate_if(Cleaned_datasets[[3]], is.numeric, log2)
View(data)
?make_se
make_se
test.data <- Cleaned_datasets[[3]]
test.data[test.data == 0] <- NA
test.data <- mutate_if(test.data, is.numeric, log2)
View(test.data)
rownames(test.data) <- test.data$name
test.data <- test.data %>% select(-Protein.IDs, -name, -Gene.names, -ID)
setwd("~/Analysis scripts/repli/data")
save(test.data, "example_dataset.rda")
save(test.data, file = "example_dataset.rda")
test.data <- Cleaned_datasets[[3]]
# Create experimental design
exp_des <- data.frame(label = colnames(Cleaned_datasets[[3]][, which(sapply(Cleaned_datasets[[3]], is.numeric))]))
exp_des <- exp_des %>% extract(label, into = c("condition", "replicate"), regex = "^(.*?)[_.](\\d+)$", remove = FALSE)
# Make SummarizedExperiment (condition and complete)
data_se <- make_se(Cleaned_datasets[[3]], which(sapply(Cleaned_datasets[[3]], is.numeric)), exp_des)
save(data_se, file = "example_se.rda")
